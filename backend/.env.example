# Example env file for backend (DO NOT commit real secrets here)
# Copy this to backend/.env and fill values before running the server

# MongoDB
MONGO_URI=

# JWT secret for signing tokens
JWT_SECRET=

# SMTP (for nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional SMTP test recipient (used by test-smtp.js)
SMTP_TEST_TO=

# Server port (optional)
PORT=5000
